# ---- Server ----
PORT=5100
NODE_ENV=development
# Frontend base URL (include the Pages repo path when deployed, no trailing slash).
CLIENT_URL=http://localhost:5173
# Optional; Render's RENDER_EXTERNAL_URL is used automatically when unset.
SERVER_URL=http://localhost:5100

# ---- Database ----
# Leave blank for the in-memory development database. Production requires an
# Atlas or other MongoDB connection URI.
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=webforge_token
PASSWORD_RESET_TOKEN_TTL_MIN=30

# ---- AI Provider ----
# Which provider to use by default: "openai" | "anthropic" | "mock"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Allow end users to supply their own key from the browser session (BYOK)
ALLOW_BYOK=true

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional; defaults to SERVER_URL/api/github/callback.
GITHUB_CALLBACK_URL=http://localhost:5100/api/github/callback

# ---- Email (password reset / verification) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WebForge AI <no-reply@webforge.dev>

# ---- Rate limiting ----
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30
